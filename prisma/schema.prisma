generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvestmentClass {
  INTERNATIONAL_STOCKS
  BRAZILIAN_STOCKS
  REAL_ESTATE_FUNDS
  REITS
  CRYPTO
  FIXED_INCOME
  INTERNATIONAL_FIXED_INCOME
}

enum InstrumentType {
  STOCK
  ETF
  REAL_ESTATE_FUND
  REIT
  CRYPTO
  FIXED_INCOME
  MUTUAL_FUND
}

enum PricingSource {
  MANUAL
  BRAPI
  YAHOO
  PLUGGY
}

enum PositionSource {
  MANUAL
  PLUGGY
}

enum ClassificationSource {
  AUTO
  EXISTING_OVERRIDE
  USER_OVERRIDE
}

enum PluggyDiagramMappingStatus {
  MAPPED
  NEEDS_REVIEW
  EXCLUDED
}

enum SuggestionExecutionStatus {
  PENDING
  AWAITING_SYNC
  EXECUTED
}

enum FixedIncomeIndexation {
  PRE_FIXED
  POST_FIXED
  INFLATION
  OTHER
}

enum RateConvention {
  FIXED_ANNUAL
  PERCENT_OF_INDEXER
  INDEXER_PLUS
  OTHER
}

enum DiagramType {
  CERRADO
  REAL_ESTATE
}

enum BudgetCategory {
  FIXED_COSTS
  COMFORT
  GOALS
  PLEASURES
  FINANCIAL_FREEDOM
  KNOWLEDGE
}

enum FinancialDataSource {
  PLUGGY
  MANUAL
}

enum FinancialAccountType {
  BANK_ACCOUNT
  CREDIT_CARD
}

enum FinanceTransactionKind {
  INCOME
  EXPENSE
}

enum FinanceAssignmentSource {
  UNASSIGNED
  PROVIDER_DEFAULT
  USER_RULE
  MANUAL
}

enum FinanceClassificationMatchType {
  MERCHANT_CNPJ
  MERCHANT_NAME
  COUNTERPARTY_NAME
  DESCRIPTION
  DESCRIPTION_PREFIX
  PROVIDER_CATEGORY
}

enum BalanceSheetCategory {
  RECEIVABLES
  INVESTMENTS
  CASH
  VALUE_LIABILITY
  CURRENT_LIABILITY
  NON_CURRENT_LIABILITY
}

enum SimulationStatus {
  DRAFT
  EXECUTED
  STALE
  CANCELLED
}

model User {
  id                         String                        @id @default(cuid())
  name                       String?
  email                      String?                       @unique
  emailVerified              DateTime?
  image                      String?
  passwordHash               String?
  sessionVersion             Int                           @default(0)
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  accounts                   Account[]
  sessions                   Session[]
  preference                 UserPreference?
  portfolio                  Portfolio?
  investmentTargets          InvestmentTarget[]
  diagramQuestions           DiagramQuestion[]
  budgetMonths               BudgetMonth[]
  recurringExpenses          RecurringExpense[]
  balanceSheetEntries        BalanceSheetEntry[]
  contributionSimulations    ContributionSimulation[]
  pluggyItems                PluggyItem[]
  financeProfile             FinanceProfile?
  financeGoals               FinanceGoal[]
  financialAccounts          FinancialAccount[]
  financeTransactions        FinanceTransaction[]
  financeTags                FinanceTag[]
  financeClassificationRules FinanceClassificationRule[]
  pluggyDiagramLinks         PluggyInvestmentDiagramLink[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model UserPreference {
  id                           String    @id @default(cuid())
  userId                       String    @unique
  theme                        String    @default("system")
  locale                       String    @default("pt-BR")
  currency                     String    @default("BRL")
  brapiApiKeyCiphertext        String?   @db.Text
  brapiApiKeyLastFour          String?
  brapiApiKeyUpdatedAt         DateTime?
  pluggyClientIdCiphertext     String?   @db.Text
  pluggyClientIdLastFour       String?
  pluggyClientSecretCiphertext String?   @db.Text
  pluggyClientSecretLastFour   String?
  pluggyCredentialUpdatedAt    DateTime?
  showSoldInvestments          Boolean   @default(false)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  user                         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Portfolio {
  id        String   @id @default(cuid())
  userId    String   @unique
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets    Asset[]
}

model Asset {
  id                    String                   @id @default(cuid())
  portfolioId           String
  investmentClass       InvestmentClass
  instrumentType        InstrumentType
  ticker                String
  name                  String
  fixedIncomeFamilyCode String?
  indexation            FixedIncomeIndexation?
  score                 Int                      @default(0)
  instrumentSource      ClassificationSource     @default(AUTO)
  exposureSource        ClassificationSource     @default(AUTO)
  groupSource           ClassificationSource     @default(AUTO)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  portfolio             Portfolio                @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  fixedIncomeFamily     FixedIncomeFamily?       @relation(fields: [fixedIncomeFamilyCode], references: [code], onDelete: Restrict)
  holdings              AssetHolding[]
  answers               AssetQuestionAnswer[]
  suggestions           ContributionSuggestion[]

  @@unique([portfolioId, investmentClass, ticker])
  @@index([portfolioId, investmentClass])
  @@index([portfolioId, instrumentType])
  @@index([portfolioId, fixedIncomeFamilyCode, indexation])
}

model FixedIncomeFamily {
  code         String             @id
  name         String
  shortCode    String
  sortOrder    Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  catalogItems AssetCatalogItem[]
  assets       Asset[]
}

model AssetCatalogItem {
  id         Int                @id
  category   String
  name       String
  summary    String             @db.Text
  taxPF      String             @db.Text
  taxPJ      String             @db.Text
  howToBuy   String             @db.Text
  costs      String             @db.Text
  risks      String             @db.Text
  guarantees String             @db.Text
  familyCode String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  family     FixedIncomeFamily? @relation(fields: [familyCode], references: [code], onDelete: SetNull)
  holdings   AssetHolding[]

  @@index([category])
  @@index([familyCode])
}

model AssetHolding {
  id                   String                       @id @default(cuid())
  assetId              String
  catalogItemId        Int?
  customTypeName       String?
  issuer               String
  productName          String
  pricingSource        PricingSource
  positionSource       PositionSource               @default(MANUAL)
  ticker               String?
  brapiAssetType       String?
  brapiSubType         String?
  marketExchange       String?
  marketQuoteType      String?
  marketSector         String?
  marketIndustry       String?
  currency             String                       @default("BRL")
  quantity             Decimal                      @default(0) @db.Decimal(30, 10)
  unitPrice            Decimal                      @default(0) @db.Decimal(30, 10)
  fxRateToBrl          Decimal?                     @db.Decimal(20, 10)
  fxUpdatedAt          DateTime?
  investedValue        Decimal?                     @db.Decimal(30, 2)
  currentValue         Decimal?                     @db.Decimal(30, 2)
  providerCurrentValue Decimal?                     @db.Decimal(30, 2)
  includedInTotals     Boolean                      @default(true)
  supersededAt         DateTime?
  fractional           Boolean                      @default(false)
  rateConvention       RateConvention?
  benchmark            String?
  rateValue            Decimal?                     @db.Decimal(12, 6)
  purchaseDate         DateTime?
  maturityDate         DateTime?
  logoUrl              String?
  priceUpdatedAt       DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  asset                Asset                        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  catalogItem          AssetCatalogItem?            @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  pluggyDiagramLink    PluggyInvestmentDiagramLink?

  @@index([assetId])
  @@index([pricingSource, ticker])
  @@index([catalogItemId])
}

model InvestmentTarget {
  id              String          @id @default(cuid())
  userId          String
  investmentClass InvestmentClass
  percentage      Decimal         @db.Decimal(5, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, investmentClass])
  @@index([userId])
}

model InvestorProfilePreset {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  targets     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DiagramQuestion {
  id        String                @id @default(cuid())
  userId    String?
  type      DiagramType
  criterion String                @default("CRITÉRIO")
  text      String
  sortOrder Int                   @default(0)
  active    Boolean               @default(true)
  isDefault Boolean               @default(false)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  user      User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers   AssetQuestionAnswer[]

  @@index([userId, type, sortOrder])
}

model AssetQuestionAnswer {
  id         String          @id @default(cuid())
  assetId    String
  questionId String
  answer     Boolean
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  asset      Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  question   DiagramQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assetId, questionId])
  @@index([questionId])
}

model BudgetMonth {
  id        String         @id @default(cuid())
  userId    String
  year      Int
  month     Int
  income    Decimal        @default(0) @db.Decimal(20, 2)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  targets   BudgetTarget[]
  expenses  Expense[]

  @@unique([userId, year, month])
  @@index([userId, year, month])
}

model BudgetTarget {
  id            String         @id @default(cuid())
  budgetMonthId String
  category      BudgetCategory
  percentage    Decimal        @db.Decimal(5, 2)
  budgetMonth   BudgetMonth    @relation(fields: [budgetMonthId], references: [id], onDelete: Cascade)

  @@unique([budgetMonthId, category])
}

model FinanceProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  monthlyIncome       Decimal  @default(0) @db.Decimal(20, 2)
  financialMonthStart Int      @default(1)
  objectives          String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FinanceGoal {
  id         String         @id @default(cuid())
  userId     String
  category   BudgetCategory
  percentage Decimal        @db.Decimal(5, 2)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
}

model FinancialAccount {
  id                  String               @id @default(cuid())
  userId              String
  source              FinancialDataSource
  externalId          String?              @unique
  providerItemId      String?
  type                FinancialAccountType
  subtype             String?
  name                String
  institutionName     String?
  institutionImageUrl String?
  accountNumber       String?
  agency              String?
  numberLastFour      String?
  bankCode            String?
  brand               String?
  balance             Decimal              @default(0) @db.Decimal(30, 2)
  creditLimit         Decimal?             @db.Decimal(30, 2)
  availableCredit     Decimal?             @db.Decimal(30, 2)
  dueDay              Int?
  closingDay          Int?
  currencyCode        String               @default("BRL")
  sortOrder           Int                  @default(0)
  active              Boolean              @default(true)
  providerUpdatedAt   DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions        FinanceTransaction[]

  @@index([userId, type, sortOrder])
  @@index([userId, active])
  @@index([userId, providerItemId])
}

model FinanceTransaction {
  id                     String                     @id @default(cuid())
  userId                 String
  accountId              String
  source                 FinancialDataSource
  externalId             String?                    @unique
  kind                   FinanceTransactionKind
  description            String
  descriptionRaw         String?
  merchantName           String?
  merchantBusinessName   String?
  merchantCnpj           String?
  merchantCategory       String?
  counterpartyName       String?
  paymentMethod          String?
  amount                 Decimal                    @db.Decimal(30, 2)
  currencyCode           String                     @default("BRL")
  originalAmount         Decimal?                   @db.Decimal(30, 2)
  originalCurrencyCode   String?
  date                   DateTime
  referenceYear          Int
  referenceMonth         Int
  referenceOverridden    Boolean                    @default(false)
  budgetCategory         BudgetCategory?
  budgetCategorySource   FinanceAssignmentSource    @default(UNASSIGNED)
  tagAssignmentSource    FinanceAssignmentSource    @default(UNASSIGNED)
  providerCategory       String?
  providerCategoryId     String?
  status                 String?
  operationType          String?
  note                   String?                    @db.Text
  ignored                Boolean                    @default(false)
  internalTransfer       Boolean                    @default(false)
  internalTransferSource FinanceAssignmentSource    @default(UNASSIGNED)
  deleted                Boolean                    @default(false)
  installmentNumber      Int?
  installmentTotal       Int?
  classificationRuleId   String?
  classifiedAt           DateTime?
  providerUpdatedAt      DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  user                   User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  account                FinancialAccount           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tags                   FinanceTransactionTag[]
  classificationRule     FinanceClassificationRule? @relation(fields: [classificationRuleId], references: [id], onDelete: SetNull)

  @@index([userId, referenceYear, referenceMonth])
  @@index([userId, date])
  @@index([accountId, date])
  @@index([userId, budgetCategory])
  @@index([userId, budgetCategorySource])
  @@index([userId, tagAssignmentSource])
  @@index([classificationRuleId])
}

model FinanceTag {
  id                  String                         @id @default(cuid())
  userId              String
  systemKey           String?
  name                String
  color               String                         @default("#3b82f6")
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  user                User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions        FinanceTransactionTag[]
  classificationRules FinanceClassificationRuleTag[]

  @@unique([userId, name])
  @@unique([userId, systemKey])
  @@index([userId, name])
}

model FinanceTransactionTag {
  transactionId String
  tagId         String
  source        FinanceAssignmentSource @default(MANUAL)
  transaction   FinanceTransaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag           FinanceTag              @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId])
}

model FinanceClassificationRule {
  id                      String                         @id @default(cuid())
  userId                  String
  matchType               FinanceClassificationMatchType
  matchValue              String
  matchLabel              String
  kind                    FinanceTransactionKind
  assignsBudgetCategory   Boolean                        @default(false)
  budgetCategory          BudgetCategory?
  assignsTags             Boolean                        @default(false)
  assignsInternalTransfer Boolean                        @default(false)
  internalTransfer        Boolean                        @default(false)
  enabled                 Boolean                        @default(true)
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  user                    User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags                    FinanceClassificationRuleTag[]
  appliedTransactions     FinanceTransaction[]

  @@unique([userId, matchType, matchValue, kind])
  @@index([userId, enabled])
}

model FinanceClassificationRuleTag {
  ruleId String
  tagId  String
  rule   FinanceClassificationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  tag    FinanceTag                @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ruleId, tagId])
  @@index([tagId])
}

model Expense {
  id                 String            @id @default(cuid())
  budgetMonthId      String
  recurringExpenseId String?
  name               String
  amount             Decimal           @db.Decimal(20, 2)
  category           BudgetCategory
  spentAt            DateTime
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  budgetMonth        BudgetMonth       @relation(fields: [budgetMonthId], references: [id], onDelete: Cascade)
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)

  @@unique([budgetMonthId, recurringExpenseId])
  @@index([budgetMonthId, category])
}

model PluggyItem {
  id                    String             @id @default(cuid())
  userId                String
  pluggyItemId          String             @unique
  connectorId           Int?
  connectorName         String
  institutionName       String?
  connectorImageUrl     String?
  connectorPrimaryColor String?
  status                String
  executionStatus       String?
  errorCode             String?
  errorMessage          String?            @db.Text
  consentExpiresAt      DateTime?
  providerUpdatedAt     DateTime?
  lastSyncAt            DateTime?
  syncPending           Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts              PluggyAccount[]
  investments           PluggyInvestment[]

  @@index([userId, status])
  @@index([userId, syncPending])
}

model PluggyAccount {
  id                String              @id @default(cuid())
  pluggyItemDbId    String
  pluggyAccountId   String              @unique
  type              String
  subtype           String?
  name              String
  marketingName     String?
  numberLastFour    String?
  balance           Decimal             @default(0) @db.Decimal(30, 2)
  currencyCode      String              @default("BRL")
  providerCreatedAt DateTime?
  providerUpdatedAt DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  item              PluggyItem          @relation(fields: [pluggyItemDbId], references: [id], onDelete: Cascade)
  transactions      PluggyTransaction[]

  @@index([pluggyItemDbId, type])
}

model PluggyTransaction {
  id                      String        @id @default(cuid())
  pluggyAccountDbId       String
  pluggyTransactionId     String        @unique
  description             String
  descriptionRaw          String?
  amount                  Decimal       @db.Decimal(30, 2)
  amountInAccountCurrency Decimal?      @db.Decimal(30, 2)
  balance                 Decimal?      @db.Decimal(30, 2)
  currencyCode            String        @default("BRL")
  date                    DateTime
  type                    String?
  status                  String?
  category                String?
  categoryId              String?
  operationType           String?
  merchantName            String?
  merchantBusinessName    String?
  merchantCnpj            String?
  merchantCategory        String?
  counterpartyName        String?
  paymentMethod           String?
  installmentNumber       Int?
  installmentTotal        Int?
  providerCreatedAt       DateTime?
  providerUpdatedAt       DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  account                 PluggyAccount @relation(fields: [pluggyAccountDbId], references: [id], onDelete: Cascade)

  @@index([pluggyAccountDbId, date])
  @@index([category])
}

model PluggyInvestment {
  id                   String                        @id @default(cuid())
  pluggyItemDbId       String
  pluggyInvestmentId   String                        @unique
  name                 String
  code                 String?
  isin                 String?
  type                 String
  subtype              String?
  balance              Decimal                       @default(0) @db.Decimal(30, 2)
  value                Decimal?                      @db.Decimal(30, 10)
  quantity             Decimal?                      @db.Decimal(30, 10)
  amount               Decimal?                      @db.Decimal(30, 2)
  taxes                Decimal?                      @db.Decimal(30, 2)
  taxes2               Decimal?                      @db.Decimal(30, 2)
  amountProfit         Decimal?                      @db.Decimal(30, 2)
  amountWithdrawal     Decimal?                      @db.Decimal(30, 2)
  amountOriginal       Decimal?                      @db.Decimal(30, 2)
  lastMonthRate        Decimal?                      @db.Decimal(20, 8)
  annualRate           Decimal?                      @db.Decimal(20, 8)
  lastTwelveMonthsRate Decimal?                      @db.Decimal(20, 8)
  currencyCode         String                        @default("BRL")
  quotaDate            DateTime?
  owner                String?
  number               String?
  institutionName      String?
  institutionNumber    String?
  insurerName          String?
  insurerCnpj          String?
  issuer               String?
  issuerCnpj           String?
  rate                 Decimal?                      @db.Decimal(20, 8)
  rateType             String?
  fixedAnnualRate      Decimal?                      @db.Decimal(20, 8)
  purchaseDate         DateTime?
  dueDate              DateTime?
  issueDate            DateTime?
  gracePeriodDate      DateTime?
  metadata             Json?
  status               String?
  providerCreatedAt    DateTime?
  providerUpdatedAt    DateTime?
  providerAvailable    Boolean                       @default(true)
  providerRemovedAt    DateTime?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  item                 PluggyItem                    @relation(fields: [pluggyItemDbId], references: [id], onDelete: Cascade)
  transactions         PluggyInvestmentTransaction[]
  diagramLink          PluggyInvestmentDiagramLink?

  @@index([pluggyItemDbId, type])
  @@index([code])
}

model PluggyInvestmentDiagramLink {
  id                       String                     @id @default(cuid())
  userId                   String
  pluggyInvestmentDbId     String                     @unique
  assetHoldingId           String?                    @unique
  status                   PluggyDiagramMappingStatus @default(NEEDS_REVIEW)
  classificationSource     ClassificationSource       @default(AUTO)
  suggestedInvestmentClass InvestmentClass?
  suggestedInstrumentType  InstrumentType?
  suggestedFamilyCode      String?
  suggestedIndexation      FixedIncomeIndexation?
  reviewReason             String?
  lastReconciledAt         DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  user                     User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  investment               PluggyInvestment           @relation(fields: [pluggyInvestmentDbId], references: [id], onDelete: Cascade)
  holding                  AssetHolding?              @relation(fields: [assetHoldingId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([assetHoldingId])
}

model PluggyInvestmentTransaction {
  id                            String           @id @default(cuid())
  pluggyInvestmentDbId          String
  pluggyInvestmentTransactionId String           @unique
  description                   String?
  type                          String
  movementType                  String?
  quantity                      Decimal?         @db.Decimal(30, 10)
  value                         Decimal?         @db.Decimal(30, 10)
  amount                        Decimal?         @db.Decimal(30, 2)
  netAmount                     Decimal?         @db.Decimal(30, 2)
  agreedRate                    Decimal?         @db.Decimal(20, 8)
  brokerageNumber               String?
  date                          DateTime
  tradeDate                     DateTime?
  expenses                      Json?
  createdAt                     DateTime         @default(now())
  updatedAt                     DateTime         @updatedAt
  investment                    PluggyInvestment @relation(fields: [pluggyInvestmentDbId], references: [id], onDelete: Cascade)

  @@index([pluggyInvestmentDbId, date])
  @@index([type])
}

model RecurringExpense {
  id        String         @id @default(cuid())
  userId    String
  name      String
  amount    Decimal        @db.Decimal(20, 2)
  category  BudgetCategory
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses  Expense[]

  @@index([userId, active])
}

model BalanceSheetEntry {
  id        String               @id @default(cuid())
  userId    String
  category  BalanceSheetCategory
  name      String
  value     Decimal              @db.Decimal(20, 2)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
}

model ContributionSimulation {
  id                String                   @id @default(cuid())
  userId            String
  portfolioVersion  Int
  requestedAmount   Decimal                  @db.Decimal(20, 2)
  unallocatedAmount Decimal                  @db.Decimal(20, 2)
  status            SimulationStatus         @default(DRAFT)
  createdAt         DateTime                 @default(now())
  executedAt        DateTime?
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestions       ContributionSuggestion[]

  @@index([userId, createdAt])
}

model ContributionSuggestion {
  id                             String                    @id @default(cuid())
  simulationId                   String
  assetId                        String
  quantity                       Decimal                   @db.Decimal(30, 10)
  value                          Decimal                   @db.Decimal(30, 10)
  suggestionPercentage           Decimal                   @db.Decimal(12, 8)
  totalAfterSuggestionPercentage Decimal                   @db.Decimal(12, 8)
  executed                       Boolean                   @default(false)
  executionStatus                SuggestionExecutionStatus @default(PENDING)
  awaitingSyncAt                 DateTime?
  baselineQuantity               Decimal?                  @db.Decimal(30, 10)
  baselineValue                  Decimal?                  @db.Decimal(30, 2)
  simulation                     ContributionSimulation    @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  asset                          Asset                     @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([simulationId, assetId])
  @@index([assetId])
}

model FaqCategory {
  id        String    @id @default(cuid())
  slug      String    @unique
  title     String
  sortOrder Int       @default(0)
  items     FaqItem[]
}

model FaqItem {
  id         String      @id @default(cuid())
  categoryId String
  question   String
  answer     String
  sortOrder  Int         @default(0)
  category   FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, sortOrder])
}

model AuthRateLimit {
  id              String    @id @default(cuid())
  scope           String
  key             String
  attempts        Int       @default(0)
  windowStartedAt DateTime
  lastAttemptAt   DateTime
  blockedUntil    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([scope, key])
  @@index([blockedUntil])
  @@index([updatedAt])
}
