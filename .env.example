POSTGRES_DB="aurum"
POSTGRES_USER="aurum_local"
POSTGRES_PASSWORD="generate-a-unique-local-password"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://aurum_local:generate-a-unique-local-password@localhost:5432/aurum?schema=public"
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_RATE_LIMIT_PEPPER="replace-with-an-independent-32-character-secret"
AUTH_TRUST_HOST="false"
AUTH_TRUST_PROXY="false"
AUTH_URL="http://localhost:3000"
CREDENTIAL_ENCRYPTION_ACTIVE_KEY="v1"
CREDENTIAL_ENCRYPTION_KEYS="v1:<base64url-encoded-32-byte-key>"
PLUGGY_WEBHOOK_SECRET="generate-a-long-random-production-secret"
